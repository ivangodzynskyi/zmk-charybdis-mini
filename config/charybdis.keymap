#include <behaviors.dtsi>
#include <dt-bindings/zmk/pointing.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse_speed.h>
#include <dt-bindings/zmk/keys.h>

// Wheel units per second for the scroll_up_* / scroll_down_* macros
#define SCROLL_SPEED(n) ((n) * 10)

// Keyboard cursor speed in pixels per second at the 100% speed level.
// Horizontal is 12/9 of vertical.
#define CURSOR_Y 600
#define CURSOR_X (CURSOR_Y * 12 / 9)

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
    require-prior-idle-ms = <125>;
};

/ {
    behaviors {
        // Tap-preferred so fast typing never turns Z into a layer hold
        lt_tp: layer_tap_tap_preferred {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        // Smooth constant-speed scroll: keeps scrolling while the key is
        // held and stops as soon as it is released
        msc_smooth: mouse_scroll_smooth {
            compatible = "zmk,behavior-input-two-axis";
            #binding-cells = <1>;
            x-input-code = <INPUT_REL_HWHEEL>;
            y-input-code = <INPUT_REL_WHEEL>;
            trigger-period-ms = <16>;
            time-to-max-speed-ms = <0>;
            acceleration-exponent = <0>;
        };

        // Cursor movement: accelerates to full speed over 300 ms while held,
        // stops on release.
        // Holding two directions adds them up into a diagonal
        mmv_accel: mouse_move_accel {
            compatible = "zmk,behavior-input-two-axis";
            #binding-cells = <1>;
            x-input-code = <INPUT_REL_X>;
            y-input-code = <INPUT_REL_Y>;
            trigger-period-ms = <8>;
            time-to-max-speed-ms = <300>;
            acceleration-exponent = <1>;
        };

        // Steps the cursor or scroll speed level up or down for the active BT profile
        mspd: mouse_speed {
            compatible = "zmk,behavior-mouse-speed";
            #binding-cells = <1>;
        };
    };

    zip_mouse_speed: zip_mouse_speed {
        compatible = "zmk,input-processor-mouse-speed";
        #input-processor-cells = <2>;
    };

    // Scroll speed follows the per-profile scroll level set on the MouseKeys layer
    msc_smooth_input_listener {
        compatible = "zmk,input-listener";
        device = <&msc_smooth>;
        input-processors = <&zip_mouse_speed 1 1>;

        // Holding X on the MouseKeys layer halves the speed
        slow {
            layers = <9>;
            input-processors = <&zip_mouse_speed 1 2>;
        };
    };

    mmv_accel_input_listener {
        compatible = "zmk,input-listener";
        device = <&mmv_accel>;
        input-processors = <&zip_mouse_speed 1 1>;

        // Holding X on the MouseKeys layer halves the speed
        slow {
            layers = <9>;
            input-processors = <&zip_mouse_speed 1 2>;
        };
    };

    macros {
        // Scroll while held: SCROLL_SPEED(n) wheel units per second
        scroll_down_slow: scroll_down_slow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &msc_smooth MOVE_Y(SCROLL_SPEED(2))>, <&macro_pause_for_release>, <&macro_release &msc_smooth MOVE_Y(SCROLL_SPEED(2))>;
        };

        scroll_up_slow: scroll_up_slow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &msc_smooth MOVE_Y(-SCROLL_SPEED(2))>, <&macro_pause_for_release>, <&macro_release &msc_smooth MOVE_Y(-SCROLL_SPEED(2))>;
        };

        scroll_down_mid: scroll_down_mid {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &msc_smooth MOVE_Y(SCROLL_SPEED(5))>, <&macro_pause_for_release>, <&macro_release &msc_smooth MOVE_Y(SCROLL_SPEED(5))>;
        };

        scroll_up_mid: scroll_up_mid {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &msc_smooth MOVE_Y(-SCROLL_SPEED(5))>, <&macro_pause_for_release>, <&macro_release &msc_smooth MOVE_Y(-SCROLL_SPEED(5))>;
        };

        scroll_down_fast: scroll_down_fast {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &msc_smooth MOVE_Y(SCROLL_SPEED(20))>, <&macro_pause_for_release>, <&macro_release &msc_smooth MOVE_Y(SCROLL_SPEED(20))>;
        };

        scroll_up_fast: scroll_up_fast {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &msc_smooth MOVE_Y(-SCROLL_SPEED(20))>, <&macro_pause_for_release>, <&macro_release &msc_smooth MOVE_Y(-SCROLL_SPEED(20))>;
        };

        cmd_c: cmd_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp C>, <&macro_release &kp LGUI>;
        };

        cmd_v: cmd_v {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp V>, <&macro_release &kp LGUI>;
        };

        cmd_z: cmd_z {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp Z>, <&macro_release &kp LGUI>;
        };
    };

    combos {
            compatible = "zmk,combos";

            combo_enter {
                bindings = <&kp ENTER>;
                key-positions = <8 9>;
                timeout-ms = <50>;
                layers = <0>;
            };

            combo_mouse_L {
                bindings = <&mkp LCLK>;
                key-positions = <7 8>;
                timeout-ms = <50>;
                layers = <0>;
            };

            combo_mouse_M {
                bindings = <&mkp MCLK>;
                key-positions = <9 10>;
                timeout-ms = <50>;
                layers = <0>;
            };

            combo_cmd_C {
                bindings = <&cmd_c>;
                key-positions = <26 27>;
                timeout-ms = <50>;
                layers = <0>;
            };

            combo_cmd_V {
                bindings = <&cmd_v>;
                key-positions = <27 28>;
                timeout-ms = <50>;
                layers = <0>;
            };

            combo_cmd_Z {
                bindings = <&cmd_z>;
                key-positions = <25 26>;
                timeout-ms = <50>;
                layers = <0>;
            };
        };

    keymap {
        compatible = "zmk,keymap";

        Base {
            label = "Base";
            bindings = <
  &kp GRAVE     &kp Q       &kp W           &mt GLOBE E         &kp R       &kp T           &lt 7 Y         &lt 7 U        &lt 6 I           &kp O        &lt 5 P             &kp LBKT
  &kp TAB       &mt LSHFT A &mt LCTRL S     &mt LEFT_ALT D      &mt LGUI F  &kp G           &kp H           &mt LGUI J     &mt LEFT_ALT K    &mt LCTRL L  &mt LSHFT SEMI      &kp APOS
  &mo 4         &lt 5 Z     &kp X           &lt 1 C             &lt 2 V     &kp B           &kp N           &kp M          &lt 3 COMMA       &kp DOT      &kp FSLH            &mkp RCLK
                                            &mkp LCLK           &lt 1 BSPC  &lt 2 ESC       &lt 8 SPACE     &kp RET
            >;
        };

        Lower {
            label = "Lower";
            bindings = <
      &trans    &trans    &trans     &trans     &trans    &trans       &kp N6       &kp N7  &kp N8  &kp N9    &kp N0    &kp RBKT
      &trans    &trans    &trans     &trans     &trans    &trans       &kp EQUAL    &kp N4  &kp N5  &kp N6    &kp BSPC  &kp BSLH
      &trans    &trans    &trans     &trans     &trans    &trans       &kp MINUS    &kp N1  &kp N2  &kp N3    &trans    &trans
                                     &trans     &trans    &trans       &kp N0       &kp DOT
            >;
        };

        Raise {
            label = "Raise";
            bindings = <
      &trans    &trans    &trans     &trans     &trans    &trans       &kp F12   &kp F7  &kp F8  &kp F9    &trans  &trans
      &trans    &trans    &trans     &trans     &trans    &trans       &kp F11   &kp F4  &kp F5  &kp F6    &trans  &trans
      &trans    &trans    &trans     &trans     &trans    &trans       &kp F10   &kp F1  &kp F2  &kp F3    &trans  &trans
                                     &trans  &trans  &trans  &trans  &trans
            >;
        };

        Arrows {
            label = "Arrows";
            bindings = <
&trans  &trans  &trans  &trans  &trans   &trans      &trans  &trans  &bootloader  &trans  &trans     &trans
&trans  &trans  &trans  &trans  &trans   &trans      &trans  &kp LEFT  &trans  &kp UP     &kp RIGHT  &trans
&trans  &trans  &trans  &trans  &trans   &trans      &trans  &kp LEFT  &trans  &kp DOWN   &kp RIGHT  &trans
                        &trans  &trans  &trans  &trans  &trans
            >;
        };

        Service {
            label = "Service";
            bindings = <
&trans  &trans  &trans        &trans        &trans         &bt BT_CLR       &trans  &trans        &trans  &trans        &trans        &trans
&trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2   &trans           &trans  &kp C_BRI_DN  &trans  &kp K_VOL_UP  &kp C_BRI_UP  &trans
&trans  &trans  &trans        &bt BT_SEL 3  &bt BT_SEL 4   &trans           &trans  &kp C_BRI_DN  &trans  &kp K_VOL_DN  &kp C_BRI_UP  &trans
                              &trans  &trans  &bootloader  &trans  &trans
            >;
        };

        Mouse {
            bindings = <
   &trans  &trans  &trans               &trans              &trans              &trans          &trans      &trans               &mkp MCLK           &mkp RCLK         &trans      &trans
   &trans  &trans  &scroll_up_slow      &scroll_up_mid      &scroll_up_fast     &trans          &trans      &scroll_up_fast      &scroll_up_mid      &scroll_up_slow   &trans      &trans
   &trans  &trans  &scroll_down_slow    &scroll_down_mid    &scroll_down_fast   &trans          &trans      &scroll_down_fast    &scroll_down_mid    &scroll_down_slow &trans      &trans
                                        &trans              &trans              &trans          &mkp LCLK   &trans
            >;
        };

        ArrowsI {
            label = "ArrowsI";
            bindings = <
&trans  &trans  &trans  &trans  &trans   &trans      &trans  &kp LEFT  &trans  &kp UP     &kp RIGHT    &trans
&trans  &trans  &trans  &trans  &trans   &trans      &trans  &kp LEFT  &trans  &kp DOWN   &kp RIGHT    &trans
&trans  &trans  &trans  &trans  &trans   &trans      &trans  &trans    &trans  &trans     &trans       &trans
                        &trans  &trans   &trans      &trans  &trans
            >;
        };

        Scr {
            bindings = <
   &trans  &trans  &trans               &trans              &trans              &trans          &trans      &trans  &scroll_up_fast     &scroll_up_mid      &scroll_up_slow     &trans
   &trans  &trans  &scroll_up_slow      &scroll_up_mid      &scroll_up_fast     &trans          &trans      &trans  &scroll_down_fast   &scroll_down_mid    &scroll_down_slow   &trans
   &trans  &trans  &scroll_down_slow    &scroll_down_mid    &scroll_down_fast   &trans          &trans      &trans  &trans              &trans              &trans              &trans
                                        &trans              &trans              &trans          &trans      &trans
            >;
        };

        // Hold Space. JKL; move at full speed, UIOP at half speed, X held
        // halves any movement, [ and ' step the cursor speed up and down.
        // D/C scroll at mid speed, F/V slowly, ` and Tab step the scroll speed
        MouseKeys {
            bindings = <
   &mspd MSPD_SCRL_INC  &trans  &trans  &trans              &trans              &trans      &trans  &mmv_accel MOVE_X(-CURSOR_X / 2)  &mmv_accel MOVE_Y(-CURSOR_Y / 2)  &mmv_accel MOVE_Y(CURSOR_Y / 2)  &mmv_accel MOVE_X(CURSOR_X / 2)  &mspd MSPD_INC
   &mspd MSPD_SCRL_DEC  &trans  &trans  &scroll_up_mid      &scroll_up_slow     &trans      &trans  &mmv_accel MOVE_X(-CURSOR_X)      &mmv_accel MOVE_Y(-CURSOR_Y)      &mmv_accel MOVE_Y(CURSOR_Y)      &mmv_accel MOVE_X(CURSOR_X)      &mspd MSPD_DEC
   &trans               &trans  &mo 9   &scroll_down_mid    &scroll_down_slow   &trans      &trans  &mkp LCLK                         &trans                            &mkp MCLK                        &mkp RCLK                        &trans
                           &trans  &trans  &trans      &trans  &trans
            >;
        };

        MouseKeysSlow {
            bindings = <
   &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
   &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
   &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
                           &trans  &trans  &trans      &trans  &trans
            >;
        };
    };
};
