#include <behaviors.dtsi>
#include <dt-bindings/zmk/pointing.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/keys.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
    require-prior-idle-ms = <125>;
};

/ {
    behaviors {
        // Tap-preferred so fast typing never turns Z into a layer hold
        lt_tp: layer_tap_tap_preferred {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        // Constant-speed scroll that emits exactly one step per trigger
        // period: 125 units/s * 40 ms = 5 wheel units per step
        msc_step: mouse_scroll_step {
            compatible = "zmk,behavior-input-two-axis";
            #binding-cells = <1>;
            x-input-code = <INPUT_REL_HWHEEL>;
            y-input-code = <INPUT_REL_WHEEL>;
            trigger-period-ms = <40>;
            time-to-max-speed-ms = <0>;
            acceleration-exponent = <0>;
        };
    };

    msc_step_input_listener {
        compatible = "zmk,input-listener";
        device = <&msc_step>;
    };

    macros {
        // Hold msc_step for 60 ms: the first step fires at 40 ms and the
        // release cancels the second one at 80 ms, giving exactly 5 lines
        scroll_down_5: scroll_down_5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <60>;
            bindings = <&macro_press &msc_step MOVE_Y(-125)>, <&macro_release &msc_step MOVE_Y(-125)>;
        };

        scroll_up_5: scroll_up_5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <60>;
            bindings = <&macro_press &msc_step MOVE_Y(125)>, <&macro_release &msc_step MOVE_Y(125)>;
        };

        cmd_c: cmd_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp C>, <&macro_release &kp LGUI>;
        };

        cmd_v: cmd_v {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp V>, <&macro_release &kp LGUI>;
        };

        cmd_z: cmd_z {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp Z>, <&macro_release &kp LGUI>;
        };
    };

    combos {
            compatible = "zmk,combos";

            combo_enter {
                bindings = <&kp ENTER>;
                key-positions = <8 9>;
                timeout-ms = <50>;
            };

            combo_mouse_L {
                bindings = <&mkp LCLK>;
                key-positions = <7 8>;
                timeout-ms = <50>;
            };

            combo_mouse_M {
                bindings = <&mkp MCLK>;
                key-positions = <9 10>;
                timeout-ms = <50>;
            };

            combo_cmd_C {
                bindings = <&cmd_c>;
                key-positions = <26 27>;
                timeout-ms = <50>;
            };

            combo_cmd_V {
                bindings = <&cmd_v>;
                key-positions = <27 28>;
                timeout-ms = <50>;
            };

            combo_cmd_Z {
                bindings = <&cmd_z>;
                key-positions = <25 26>;
                timeout-ms = <50>;
            };
        };

    keymap {
        compatible = "zmk,keymap";

        Base {
            label = "Base";
            bindings = <
  &kp GRAVE  &kp Q      &kp W            &kp E               &kp R       &kp T        &lt 7 Y       &kp U          &kp I             &kp O        &kp P             &kp LBKT
  &kp TAB  &mt LSHFT A  &mt LCTRL S      &mt LEFT_ALT D      &mt LGUI F  &kp G        &lt_tp 6 H    &mt LGUI J     &mt LEFT_ALT K    &mt LCTRL L  &mt LSHFT SEMI    &kp APOS
  &mo 4    &kp Z        &kp X            &lt 1 C             &lt 2 V     &kp B        &kp N         &kp M          &kp COMMA         &kp DOT      &lt 5 FSLH          &mkp RCLK
                                         &mkp LCLK  &lt 1 BSPC  &lt 2 ESC  &lt 1 SPACE  &kp RET
            >;
        };

        Lower {
            label = "Lower";
            bindings = <
      &trans    &trans    &trans     &trans     &trans    &trans       &kp N6      &kp N7  &kp N8  &kp N9  &kp N0   &kp RBKT
      &trans    &trans    &trans     &trans     &trans    &trans       &kp EQUAL   &kp N4  &kp N5  &kp N6    &trans  &kp BSLH
      &trans    &trans    &trans     &trans     &trans    &trans       &kp MINUS   &kp N1  &kp N2  &kp N3    &trans  &trans
                                     &trans  &trans  &trans  &kp N0  &kp DOT
            >;
        };

        Raise {
            label = "Raise";
            bindings = <
      &trans    &trans    &trans     &trans     &trans    &trans       &kp F12   &kp F7  &kp F8  &kp F9    &trans  &trans
      &trans    &trans    &trans     &trans     &trans    &trans       &kp F11   &kp F4  &kp F5  &kp F6    &trans  &trans
      &trans    &trans    &trans     &trans     &trans    &trans       &kp F10   &kp F1  &kp F2  &kp F3    &trans  &trans
                                     &trans  &trans  &trans  &trans  &trans
            >;
        };

        Arrows {
            label = "Arrows";
            bindings = <
&trans  &trans  &trans  &trans  &trans   &trans      &trans  &trans  &bootloader  &trans  &trans     &trans
&trans  &trans  &trans  &trans  &trans   &trans      &trans  &kp LEFT  &trans  &kp UP     &kp RIGHT  &trans
&trans  &trans  &trans  &trans  &trans   &trans      &trans  &kp LEFT  &trans  &kp DOWN   &kp RIGHT  &trans
                        &trans  &trans  &trans  &trans  &trans
            >;
        };

        Service {
            label = "Service";
            bindings = <
&trans  &trans  &trans        &trans        &trans         &bt BT_CLR       &trans  &trans        &trans  &trans        &trans        &trans
&trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2   &trans           &trans  &kp C_BRI_DN  &trans  &kp K_VOL_UP  &kp C_BRI_UP  &trans
&trans  &trans  &trans        &bt BT_SEL 3  &bt BT_SEL 4   &trans           &trans  &kp C_BRI_DN  &trans  &kp K_VOL_DN  &kp C_BRI_UP  &trans
                              &trans  &trans  &bootloader  &trans  &trans
            >;
        };

        Mouse {
            bindings = <
   &trans  &trans  &trans     &trans  &trans     &trans    &trans  &trans     &trans       &trans     &trans     &trans
   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &scroll_up_5  &scroll_up_5  &scroll_up_5  &trans  &trans
   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &scroll_down_5  &scroll_down_5  &scroll_down_5  &trans  &trans
                              &trans  &trans  &trans  &trans  &trans
            >;
        };

        Precise {
            label = "Precise";
            bindings = <
   &trans  &trans  &trans     &trans  &trans     &trans    &trans  &trans     &trans       &trans     &trans     &trans
   &trans  &trans  &trans     &trans  &trans     &trans    &trans  &trans     &trans       &trans     &trans     &trans
   &trans  &trans  &trans     &trans  &trans     &trans    &trans  &trans     &trans       &trans     &trans     &trans
                              &trans  &trans  &trans  &trans  &trans
            >;
        };

        RightHandScroll {
            label = "RightHandScroll";
            bindings = <
   &trans  &trans  &trans     &trans  &trans     &trans    &trans  &mkp MCLK  &mkp RCLK    &trans     &trans     &trans
   &trans  &trans  &trans     &trans  &trans     &trans    &trans  &trans     &trans       &trans     &trans     &trans
   &trans  &trans  &trans     &trans  &trans     &trans    &trans  &trans     &trans       &trans     &trans     &trans
                              &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
