#include <input/processors/code_mapper.dtsi>
#include <input/processors/scaler.dtsi>

&i2c0 {
    status = "okay";
    compatible = "nordic,nrf-twim";
    // nice_nano pinctrl: SDA = P0.17, SCL = P0.20

    trackpad: trackpad@2a {
        status = "okay";
        compatible = "cirque,pinnacle";
        reg = <0x2a>;
        // No DR pin wired: the driver polls instead (CONFIG_INPUT_PINNACLE_POLL_INTERVAL_MS)
        sensitivity = "2x";
        // rotate-90;
        // x-invert;
        y-invert;
        // no-taps;
        // no-secondary-tap;
    };
};

/ {
    trackpad_listener {
        compatible = "zmk,input-listener";
        device = <&trackpad>;

        scroller {
            layers = <2>;
            input-processors = <&zip_xy_to_scroll_mapper &zip_scroll_scaler 1 2>;
        };
    };
};
